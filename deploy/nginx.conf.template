# Rendered to /etc/nginx/conf.d/default.conf at container start by the base
# image's 20-envsubst-on-templates.sh. Only variables present in the
# environment are substituted, so nginx's own $host, $uri and friends survive.
#
# ${API_UPSTREAM} has already had any trailing slash stripped by
# /docker-entrypoint.d/10-normalise-upstream.envsh.

server {
    # The unprivileged base image cannot bind below 1024.
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    server_tokens off;
    charset utf-8;

    # Never emit a redirect carrying this container's internal port.
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    # Declared once at server level. No location below uses add_header, because
    # an add_header inside a location discards the inherited set.
    add_header X-Frame-Options          "DENY"        always;
    add_header X-Content-Type-Options   "nosniff"     always;
    add_header Referrer-Policy          "no-referrer" always;

    # An admin console over personal data should not be indexed if it is ever
    # reachable from somewhere that crawls.
    add_header X-Robots-Tag "noindex, nofollow" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        image/svg+xml;

    client_max_body_size 2m;

    # ---- the API, same origin ----
    #
    # The service's routes sit at its root. The panel calls /api/admin/stats and
    # the trailing slash on proxy_pass strips the prefix, so the upstream sees
    # /admin/stats.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Identity is decided here, not by the browser. proxy_set_header
        # overwrites whatever the client sent, so a caller that can set a header
        # cannot forge this one.
        proxy_set_header ${API_CALLER_HEADER} "${API_CALLER}";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The API takes 2-12s per answer and about 10s on its first request
        # after a restart. Nothing here may be short.
        proxy_connect_timeout 15s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        # Do not hold a slow answer in a buffer before passing it on.
        proxy_buffering off;
        proxy_request_buffering off;

        # A dead upstream is a 502 from this location, not a broken panel.
        proxy_intercept_errors off;
    }

    # ---- the panel ----

    # Content-hashed filenames, so they can be cached hard.
    location /assets/ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # The entry point must never be cached, or a deploy keeps serving the old
    # bundle from the browser.
    location = /index.html {
        expires -1;
    }

    # Client-side routing: /conversations/<id> and /catalogue/<id> are real
    # panel routes with no file behind them.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
